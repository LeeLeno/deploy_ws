diff --git a/deploy/include/unitree_articulation.h b/deploy/include/unitree_articulation.h
index 40b7572..c6ce7bf 100644
--- a/deploy/include/unitree_articulation.h
+++ b/deploy/include/unitree_articulation.h
@@ -38,9 +38,27 @@ public:
             data.joint_pos[i] = lowstate->msg_.motor_state()[data.joint_ids_map[i]].q();
             data.joint_vel[i] = lowstate->msg_.motor_state()[data.joint_ids_map[i]].dq();
         }
+        // Reconstruct the MuJoCo `torso_gyro` sensor used by the MimicLite
+        // actor.  The low-state IMU is at the pelvis; SDK motors 12/13/14 are
+        // waist yaw/roll/pitch.  Read them by motor index: data.joint_pos is in
+        // the policy's order (joint_ids_map), which is not SDK order for
+        // IsaacLab policies.
+        const auto& ms = lowstate->msg_.motor_state();
+        const Eigen::AngleAxisf yaw(ms[12].q(), Eigen::Vector3f::UnitZ());
+        const Eigen::AngleAxisf roll(ms[13].q(), Eigen::Vector3f::UnitX());
+        const Eigen::AngleAxisf pitch(ms[14].q(), Eigen::Vector3f::UnitY());
+        const Eigen::Matrix3f R_p = data.root_quat_w.toRotationMatrix();
+        const Eigen::Matrix3f R_y = yaw.toRotationMatrix();
+        const Eigen::Matrix3f R_r = roll.toRotationMatrix();
+        const Eigen::Matrix3f R_t = R_p * R_y * R_r * pitch.toRotationMatrix();
+        const Eigen::Vector3f omega_b = data.root_ang_vel_b
+            + Eigen::Vector3f(0.0f, 0.0f, ms[12].dq())
+            + R_y * Eigen::Vector3f(ms[13].dq(), 0.0f, 0.0f)
+            + R_y * R_r * Eigen::Vector3f(0.0f, ms[14].dq(), 0.0f);
+        data.torso_ang_vel_b = R_t.transpose() * (R_p * omega_b);
     }
 
     LowStatePtr lowstate;
 };
 
-}
\ No newline at end of file
