diff --git a/deploy/robots/g1_29dof/include/State_WBT.h b/deploy/robots/g1_29dof/include/State_WBT.h
new file mode 100755
index 0000000..0df7514
--- /dev/null
+++ b/deploy/robots/g1_29dof/include/State_WBT.h
@@ -0,0 +1,58 @@
+// SPDX-FileCopyrightText: 2026 deploy_ws (parallel WBT chain — independent of
+//   upstream State_Mimic; do not delete in upstream sync).
+//
+// State_WBT — runs a UniLab WBT (whole-body tracking) policy alongside upstream
+// State_Mimic without sharing any runtime state.  The actor obs / action /
+// motion-clip schemas are NOT compatible with State_Mimic and must not be
+// crossed-wired.
+//
+// Current contract: G1SonicMimicDR (1570-d actor obs -> 29-d action), see
+// WBT_Policy.h.  Source of truth for cfg: deploy_ws/assets/
+// sonicmimic_dr_*_deploy_config.yaml + policy.onnx(+.data) + the motion bin
+// exported from the training NPZ by scripts/export_motion_bin.py.  The
+// numerics live in WBTPolicy (DDS-free); this class only does threading,
+// LowCmd publishing and FSM transitions.
+#pragma once
+
+#include "FSM/State_RLBase.h"   // pulls in FSMState transitively; matches State_Mimic.h pattern
+#include "WBT_Policy.h"
+
+#include <atomic>
+#include <memory>
+#include <mutex>
+#include <string>
+#include <thread>
+#include <vector>
+
+
+class State_WBT : public FSMState
+{
+public:
+    State_WBT(int state_mode, std::string state_string);
+
+    void enter() override;
+    void run()   override;
+    void exit()  override;
+
+private:
+    void policy_loop();
+
+    std::unique_ptr<WBTPolicy> policy_;
+    int start_frame_ = 0;
+    int end_frame_   = 0;   // last motion frame played (inclusive)
+
+    std::thread       policy_thread_;
+    std::atomic<bool> policy_thread_running_{false};
+
+    // Nothing of this state (gains or q) is published until the first
+    // inference of the current entry has produced a valid target; until then
+    // LowCmd keeps the previous state's command.
+    std::atomic<bool>  target_ready_{false};
+    std::atomic<bool>  motion_done_{false};
+    std::atomic<bool>  bad_orientation_{false};   // evaluated on the policy thread's snapshot
+    std::atomic<bool>  fault_{false};
+    std::mutex         target_mtx_;
+    std::vector<float> q_target_;   // policy order, guarded by target_mtx_
+};
+
+REGISTER_FSM(State_WBT)
diff --git a/deploy/robots/g1_29dof/include/WBT_Policy.h b/deploy/robots/g1_29dof/include/WBT_Policy.h
new file mode 100644
index 0000000..988dee0
--- /dev/null
+++ b/deploy/robots/g1_29dof/include/WBT_Policy.h
@@ -0,0 +1,147 @@
+// SPDX-FileCopyrightText: 2026 deploy_ws (parallel WBT chain — independent of
+//   upstream State_Mimic; do not delete in upstream sync).
+//
+// WBTPolicy — DDS-free computational core of State_WBT for the UniLab
+// G1SonicMimicDR actor (1570-d obs -> 29-d action).  It owns the
+// ManagerBasedRLEnv (obs/action managers + OrtRunner) and the motion clip, and
+// implements the deploy contract of
+//   UniLab conf/warpsac/task/sonicmimic/mjwarp_dr.yaml  +  tmp/sim_prototype.py
+// Nothing here touches DDS / LowCmd, so the offline parity test links it
+// against a fake LowState (deploy_ws/scripts/parity/).
+//
+// Actor obs (group-by-term flatten, rows oldest -> newest), offsets in floats:
+//   base_ang_vel          [   0,  30)  3 x 10  IMU gyro (pelvis)
+//   joint_pos             [  30, 320) 29 x 10  q - default_angles
+//   joint_vel             [ 320, 610) 29 x 10  dq
+//   actions               [ 610, 900) 29 x 10  previous raw policy output
+//   command_multi_future  [ 900,1540) 640      10 frames x [ref q(29), ref dq(29), ori6d(6)]
+//   projected_gravity     [1540,1570)  3 x 10  R(pelvis)^T * [0,0,-1]
+// (the actual offsets are derived from deploy_config.yaml obs_layout.)
+#pragma once
+
+#include "isaaclab/envs/manager_based_rl_env.h"
+
+#include <memory>
+#include <string>
+#include <vector>
+
+#include <eigen3/Eigen/Dense>
+#include <yaml-cpp/yaml.h>
+
+
+// Motion clip loader for the WBT binary produced by
+// deploy_ws/scripts/export_motion_bin.py from the training NPZ.
+//
+// Layout (little-endian, frames-major float32 data after 16-byte header):
+//   header (16B, four int32):  fps, num_frames, num_joints, num_bodies
+//   joint_pos      [F][J]
+//   joint_vel      [F][J]
+//   body_pos_w     [F][B][3]
+//   body_quat_w    [F][B][4]   wxyz
+//   body_lin_vel_w [F][B][3]
+//   body_ang_vel_w [F][B][3]
+//
+// B is the full NPZ body set (column 0 = world body), so the anchor index is
+// the raw NPZ column (torso_link = 16).  Playback is by integer frame — one
+// motion frame per 50 Hz policy step, exactly like the training command's
+// time_steps — no interpolation and no quaternion re-normalisation.
+class WBTMotionLoader
+{
+public:
+    WBTMotionLoader(const std::string& path, int anchor_body_idx);
+
+    int fps()        const { return fps_; }
+    int num_frames() const { return num_frames_; }
+    int num_joints() const { return num_joints_; }
+    int num_bodies() const { return num_bodies_; }
+    int last_frame() const { return num_frames_ - 1; }
+
+    const float* joint_pos(int frame) const { return &joint_pos_[static_cast<std::size_t>(frame) * num_joints_]; }
+    const float* joint_vel(int frame) const { return &joint_vel_[static_cast<std::size_t>(frame) * num_joints_]; }
+    const Eigen::Quaternionf& anchor_quat(int frame) const { return anchor_quat_w_[frame]; }
+
+private:
+    int fps_        = 0;
+    int num_frames_ = 0;
+    int num_joints_ = 0;
+    int num_bodies_ = 0;
+    int anchor_idx_ = 0;
+
+    std::vector<float>              joint_pos_;      // (F*J)
+    std::vector<float>              joint_vel_;      // (F*J)
+    std::vector<Eigen::Quaternionf> anchor_quat_w_;  // (F) wxyz, as stored
+};
+
+
+class WBTPolicy
+{
+public:
+    // deploy_cfg: assets/sonicmimic_dr_*_deploy_config.yaml.  kp / kd: motor
+    // gains in SDK order (config.yaml FSM block).  robot: articulation whose
+    // update() snapshots the sensors (BaseArticulation<LowState> on the robot).
+    WBTPolicy(const YAML::Node& deploy_cfg,
+              const std::vector<float>& kp,
+              const std::vector<float>& kd,
+              const std::string& motion_path,
+              const std::string& policy_path,
+              std::shared_ptr<isaaclab::Articulation> robot);
+
+    // Both calls consume the robot snapshot taken by the caller's latest
+    // env()->robot->update(); neither re-reads the sensors.
+    //
+    // begin(): start a fresh episode at start_frame — yaw-align the reference
+    // to the current torso heading, zero the last action, and prime every
+    // history row with this snapshot.  The step() that follows on the SAME
+    // snapshot therefore sees all 10 rows equal to it (sim_prototype's first
+    // push), which is also what makes re-entry independent of the last run.
+    void begin(int start_frame);
+    // step(): assemble obs at frame(), run the policy, q_target = a*scale + default
+    // (no clip, no filter, no latency), then advance to the next motion frame.
+    // Throws on non-finite obs / action (the action is then NOT applied).
+    void step();
+
+    int  frame()      const { return frame_; }   // motion frame the next step() uses
+    bool has_action() const { return has_action_; }
+    float step_dt()   const { return env_->step_dt; }
+
+    const std::vector<float>& obs()        const { return obs_; }
+    const std::vector<float>& raw_action() const { return raw_action_; }
+    const std::vector<float>& q_target()   const { return q_target_; }
+    const Eigen::Quaternionf& init_quat()  const { return init_quat_; }
+
+    const WBTMotionLoader&        motion() const { return *motion_; }
+    isaaclab::ManagerBasedRLEnv*  env()          { return env_.get(); }
+
+    // Torso (anchor) orientation in world from the snapshot: pelvis IMU quat
+    // followed by waist yaw(Z) / roll(X) / pitch(Y).  Exact for the G1 MJCF,
+    // whose waist_yaw_link / waist_roll_link / torso_link bodies carry no
+    // fixed rotation.  Policy-order joint indices 12/13/14.
+    static Eigen::Quaternionf torso_quat_w(const isaaclab::ArticulationData& data);
+
+    // wbt_command_multi_future registrar body (640-d).
+    std::vector<float> command_multi_future(const isaaclab::ManagerBasedRLEnv* env) const;
+
+    // The registrar reads the active WBT policy through this pointer; set by
+    // the constructor and by begin().
+    static WBTPolicy* active;
+
+private:
+    static YAML::Node build_env_cfg(const YAML::Node& deploy_cfg,
+                                    const std::vector<float>& kp,
+                                    const std::vector<float>& kd);
+
+    std::shared_ptr<WBTMotionLoader>             motion_;
+    std::unique_ptr<isaaclab::ManagerBasedRLEnv> env_;
+
+    std::vector<int> future_steps_;
+    int  obs_dim_    = 0;
+    int  action_dim_ = 0;
+    int  frame_      = 0;
+    bool begun_      = false;
+    bool has_action_ = false;
+    Eigen::Quaternionf init_quat_ = Eigen::Quaternionf::Identity();
+
+    std::vector<float> obs_;
+    std::vector<float> raw_action_;
+    std::vector<float> q_target_;
+};
