diff --git a/deploy/robots/g1_29dof/include/State_WBT.h b/deploy/robots/g1_29dof/include/State_WBT.h
new file mode 100644
index 0000000..c9330c0
--- /dev/null
+++ b/deploy/robots/g1_29dof/include/State_WBT.h
@@ -0,0 +1,120 @@
+// SPDX-FileCopyrightText: 2026 deploy_ws (parallel WBT chain — independent of
+//   upstream State_Mimic; do not delete in upstream sync).
+//
+// State_WBT — runs a UniLab WBT (whole-body tracking) policy alongside upstream
+// State_Mimic without sharing any runtime state.  The actor obs / action /
+// motion-clip schemas are NOT compatible with State_Mimic and must not be
+// crossed-wired.
+//
+// Source of truth for cfg: deploy_ws/assets/deploy_config.yaml + dance*.bin +
+// policy.onnx — those are produced by UniLab's scripts/deploy/export_*.py.
+// State_WBT reads them directly so swapping the three files in assets/ is
+// enough to redeploy a new training checkpoint.
+#pragma once
+
+#include "FSM/State_RLBase.h"   // pulls in FSMState transitively; matches State_Mimic.h pattern
+#include "isaaclab/envs/manager_based_rl_env.h"
+
+#include <array>
+#include <atomic>
+#include <memory>
+#include <string>
+#include <thread>
+#include <vector>
+
+#include <eigen3/Eigen/Dense>
+
+
+// Motion clip loader for the UniLab WBT binary format produced by
+// UniLab/scripts/deploy/export_motion_bin.py.
+//
+// Layout (little-endian, frames-major float32 data after 16-byte header):
+//   header (16B, four int32):  fps, num_frames, num_joints, num_bodies
+//   joint_pos      [F][J]
+//   joint_vel      [F][J]
+//   body_pos_w     [F][B][3]
+//   body_quat_w    [F][B][4]   wxyz (matches mujoco / unitree_articulation)
+//   body_lin_vel_w [F][B][3]
+//   body_ang_vel_w [F][B][3]
+//
+// State_WBT only consumes joint_{pos,vel} and body_quat_w[anchor]; the rest is
+// loaded for diagnostics and future fields (e.g. anchor_pos_b when re-enabled
+// in training) but is otherwise dormant.
+class WBTMotionLoader
+{
+public:
+    explicit WBTMotionLoader(const std::string& path, int anchor_idx_in_tracked = 7);
+
+    // Re-index the cursor for a playback time in seconds (clamped to [0, duration]).
+    void update(float time);
+
+    // Linear / spherical interpolation between adjacent frames at current cursor.
+    Eigen::VectorXf    joint_pos()   const;
+    Eigen::VectorXf    joint_vel()   const;
+    Eigen::Quaternionf anchor_quat() const;   // wxyz
+    Eigen::Vector3f    anchor_pos()  const;
+
+    int   fps()         const { return fps_; }
+    int   num_frames()  const { return num_frames_; }
+    int   num_joints()  const { return num_joints_; }
+    int   num_bodies()  const { return num_bodies_; }
+    float duration()    const { return duration_; }
+
+private:
+    int fps_         = 0;
+    int num_frames_  = 0;
+    int num_joints_  = 0;
+    int num_bodies_  = 0;
+    int anchor_idx_  = 0;
+
+    float dt_       = 0.0f;
+    float duration_ = 0.0f;
+
+    int   index_0_ = 0;
+    int   index_1_ = 0;
+    float blend_   = 0.0f;
+
+    // Per-frame caches in flat row-major layout, slice with mat::row(f) at access time.
+    Eigen::MatrixXf joint_pos_;  // (F, J)
+    Eigen::MatrixXf joint_vel_;  // (F, J)
+    // Anchor body slices — full 14-body arrays are loaded but only the anchor
+    // slice is exposed; State_WBT does not currently consume the others.
+    std::vector<Eigen::Vector3f>    anchor_pos_w_;   // (F)
+    std::vector<Eigen::Quaternionf> anchor_quat_w_;  // (F) wxyz
+};
+
+
+class State_WBT : public FSMState
+{
+public:
+    State_WBT(int state_mode, std::string state_string);
+
+    void enter() override;
+    void run()   override;
+    void exit()  override;
+
+    // Shared with the wbt_* observation registrars defined in State_WBT.cpp.
+    // Set in enter() (per-instance), nullptr otherwise — the registrar guards
+    // against null to remain safe when a different FSM is active.
+    static std::shared_ptr<WBTMotionLoader> motion;
+    // Yaw-only alignment between robot heading and ref-motion frame-0 heading,
+    // computed at FSM enter.  Keeps motion_anchor_ori_b residual ≈ I at t=0
+    // (matches UniLab's RSI assumption when the robot can't actually teleport).
+    static Eigen::Quaternionf init_quat;
+
+private:
+    // Build a YAML::Node in the upstream ManagerBasedRLEnv schema directly from
+    // the UniLab-format deploy_config.yaml.  Single source of truth = the file
+    // produced by scripts/deploy/export_deploy_config.py.
+    YAML::Node build_env_cfg(const YAML::Node& deploy_cfg) const;
+
+    std::unique_ptr<isaaclab::ManagerBasedRLEnv> env_;
+    std::shared_ptr<WBTMotionLoader>             motion_;
+    std::array<float, 2>                         time_range_{0.0f, 0.0f};
+    int                                          anchor_body_idx_in_tracked_ = 7;
+
+    std::thread       policy_thread_;
+    std::atomic<bool> policy_thread_running_{false};
+};
+
+REGISTER_FSM(State_WBT)
