+@pytest.mark.parametrize("yaw_deg", [0, 90, 180])
+@pytest.mark.parametrize("roll_deg,pitch_deg", [(0, 0), (10, 0), (-10, 0), (0, 10), (0, -10), (20, -15)])
+def test_policy_gravity_is_body_frame_and_yaw_invariant(roll_deg, pitch_deg, yaw_deg):
+    cfg = compose_task("g1_flash_mimic/mjwarp_fast")
+    model = mujoco.MjModel.from_xml_path(cfg.env.scene.model_file)
+    data = mujoco.MjData(model)
+    mujoco.mj_resetDataKeyframe(model, data, model.key("stand").id)
+
+    roll, pitch, yaw = np.deg2rad([roll_deg, pitch_deg, yaw_deg])
+    q_roll = np.array([np.cos(roll / 2), np.sin(roll / 2), 0, 0])
+    q_pitch = np.array([np.cos(pitch / 2), 0, np.sin(pitch / 2), 0])
+    q_yaw = np.array([np.cos(yaw / 2), 0, 0, np.sin(yaw / 2)])
+    q_tilt = np.empty(4)
+    mujoco.mju_mulQuat(q_tilt, q_pitch, q_roll)
+    mujoco.mju_mulQuat(data.qpos[3:7], q_yaw, q_tilt)
+    mujoco.mj_forward(model, data)
+
+    # For R = Rz(yaw) Ry(pitch) Rx(roll), R.T @ [0, 0, -1] is
+    # independent of yaw. The old -R @ [0, 0, 1] reverses tilt feedback.
+    expected = [np.sin(pitch), -np.cos(pitch) * np.sin(roll), -np.cos(pitch) * np.cos(roll)]
+    for group in ("actor", "critic"):
+        term = cfg.env.observations[group].terms.projected_gravity_u
+        gravity = -data.sensor(term.params.sensor_name).data
+        np.testing.assert_allclose(gravity, expected, atol=1e-12)
