+// Compatibility with FlashMimic 60k: training negates MuJoCo's world-frame
+// pelvis Z axis. Undo begin()'s reference yaw alignment for arbitrary IMU yaw.
+REGISTER_OBSERVATION(wbt_training_gravity)
+{
+    if (!WBTPolicy::active) {
+        throw std::runtime_error("wbt_training_gravity: no active WBTPolicy");
+    }
+    const Eigen::Vector3f g = WBTPolicy::active->init_quat().conjugate()
+        * (env->robot->data.root_quat_w * Eigen::Vector3f(0.0f, 0.0f, -1.0f));
+    return std::vector<float>(g.data(), g.data() + 3);
 }
